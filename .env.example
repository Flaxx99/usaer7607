# Copia este archivo como .env y ajusta los valores.
# NUNCA commitees el .env real.

# Django
DEBUG=True
SECRET_KEY="genera-una-clave-segura-con-python-c-import-secrets-print-secrets-token-urlsafe-50"
ALLOWED_HOSTS="127.0.0.1,localhost,localhost:5173"

# Base de datos (default: SQLite local)
# Para PostgreSQL:
# DATABASE_URL="postgres://user:password@host:5432/dbname"

# Frontend (CORS + CSRF)
CORS_ALLOWED_ORIGINS="http://localhost:5173"
CSRF_TRUSTED_ORIGINS="http://localhost:5173"

# Seguridad (opcional — si no se setean, no se activan)
SENTRY_DSN="https://key@oXXXX.ingest.de.sentry.io/PROJECT_ID"
