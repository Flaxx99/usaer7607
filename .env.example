# ═══════════════════════════════════════════════
# USAER — Variables de Entorno
# ═══════════════════════════════════════════════
# Copia este archivo como .env y ajusta los valores:
#   cp .env.example .env
#
# Las variables se cargan automáticamente desde .env
# gracias a python-dotenv en settings.py.

# ─── Django ─────────────────────────────────────
# Modo debug. NUNCA en True en producción.
DEBUG=False

# Secreto de Django. Genera uno nuevo para cada entorno:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=changeme-put-a-real-secret-key-here

# Hosts permitidos separados por coma (sin espacios).
# En producción agrega tu dominio.
ALLOWED_HOSTS=127.0.0.1,localhost

# ─── Base de Datos ──────────────────────────────
# Por defecto usa SQLite local.
# Para PostgreSQL (producción):
#   DATABASE_URL=postgres://usuario:password@host:5432/usaer
# DATABASE_URL=

# ─── Cache (Redis — opcional) ───────────────────
# Si no se define, usa LocMemCache (perfecto para local y tests).
# Para producción con Redis:
#   REDIS_URL=redis://:password@host:6379/0
#
# Requiere django-redis instalado (ya está en requirements.txt).
# REDIS_URL=

# ─── Monitoreo (Sentry — opcional) ──────────────
# DSN de Sentry para error tracking en producción.
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# ─── CORS / CSRF ────────────────────────────────
# Orígenes permitidos para CORS y CSRF, separados por coma.
# El default funciona con Vite en desarrollo (puerto 5173).
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# CSRF_TRUSTED_ORIGINS=http://localhost:5173
